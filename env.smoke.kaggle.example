# Smoke test environment — Kaggle backend
# Copy to .env.smoke.kaggle and fill in live values.
# NEVER commit .env.smoke.kaggle — it contains secrets.

# Live API base URL (no trailing slash)
API_URL=https://llm-api.example.com

# Auth0 M2M credentials (management app, client_credentials flow)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://llm-api.example.com
AUTH0_MGMT_CLIENT_ID=your-client-id
AUTH0_MGMT_CLIENT_SECRET=your-client-secret

# Kaggle credentials (used by the training worker to submit the notebook)
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
