# Smoke test environment — RunPod backend
# Copy to .env.smoke.runpod and fill in live values.
# NEVER commit .env.smoke.runpod — it contains secrets.

# Live API base URL (no trailing slash)
API_URL=https://llm-api.example.com

# Auth0 M2M credentials (management app, client_credentials flow)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://llm-api.example.com
AUTH0_MGMT_CLIENT_ID=your-client-id
AUTH0_MGMT_CLIENT_SECRET=your-client-secret

# RunPod credentials (used by the training worker)
RUNPOD_API_KEY=your-runpod-api-key

# AWS credentials for S3 artifact storage
AWS_S3_BUCKET=your-s3-bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
